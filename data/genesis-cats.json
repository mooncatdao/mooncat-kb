  "contract": {
    "genesisIdFormula": {
      "formula": "(bytes5(genesisCatIndex) << 24) | 0xff00000ca7",
      "indexType": "uint8 / Genesis index",
      "outputType": "bytes5 catId",
      "sourceRefs": [
        "ponderware-mooncatrescue-sol-raw"
      ]
    },
    "releaseMechanism": {
      "function": "addGenesisCatGroup",
      "signature": "addGenesisCatGroup()",
      "groupSize": 16,
      "operator": "contract owner",
      "access": [
        "onlyOwner",
        "activeMode"
      ],
      "activeModeDefinition": "Modes.Live or Modes.Test",
      "precondition": "remainingGenesisCats > 0",
      "behavior": "Creates the next group of Genesis identifiers, inserts them into the shared rescue-order sequence, and makes them available through adoption offers; this is distinct from normal rescue.",
      "priceFormula": "(17 - (remainingGenesisCats / 16)) * 300000000000000000 wei, evaluated before the 16-member loop",
      "perCatStateTransition": [
        "genesisCatIndex = 256 - remainingGenesisCats",
        "genesisCatId = (bytes5(genesisCatIndex) << 24) | 0xff00000ca7",
        "append genesisCatId at rescueOrder[rescueIndex] and increment rescueIndex",
        "increment balanceOf[0x0]",
        "decrement remainingGenesisCats",
        "create open AdoptionOffer(true, genesisCatId, owner, price, 0x0)"
      ],
      "ownershipBoundary": "addGenesisCatGroup does not assign catOwners[genesisCatId] to the contract owner; the default zero-address owner remains until the adoption transfer assigns the adopter.",
      "emittedEvent": "GenesisCatsAdded(bytes5[16])",
      "sourceRefs": [
        "ponderware-mooncatrescue-sol-raw",
        "origin-mooncatrescue-info"
      ]
    },
    "adoptionPriceSchedule": {
      "kind": "scheduled-per-release-group",
      "firstGroupWei": 300000000000000000,
      "incrementWei": 300000000000000000,
      "formula": "priceWei = groupNumber * 300000000000000000 for a released group numbered from 1",
      "sourceRefs": [
        "origin-mooncatrescue-info"
      ],
      "limit": "Only the six historically released groups are listed. No unreleased-group price or aggregate payment claim is made."
    },
    "adoptionPaymentBehavior": {
      "intendedRevenue": "Original project information says adoption proceeds were intended for the developers.",
      "qaBug": "The original project information attributes a QA-change bug to the payment routing outcome.",
      "actualDestination": "zero address",
      "economicLanguage": "The original source describes this as burned Ether; this reconstruction does not derive a transaction aggregate.",
      "scope": "Genesis adoption payments only; do not generalize this behavior to other payment paths.",
      "transactionAggregate": "not-evaluated",
